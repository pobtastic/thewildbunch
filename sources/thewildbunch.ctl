b $E92F BASIC Terminator
@ $E92F label=BASIC_Terminator
D $E92F #HTML(#N$FFFF marker after the BASIC program, followed by two spare bytes
. before the <code>USR</code> target.)
  $E92F,$02

u $E931
B $E931,$02

c $E933 Run Bootstrap
@ $E933 label=Run_Bootstrap
D $E933 One-shot startup trampoline. BASIC line 1 enters here via
. USR(VARS-#N$74). It is not game logic: it finishes the load, replaces the
. decoy line 1 at #SKOOLKID$5C53(PROG) with the real opening from #R$5B01,
. points BASIC at line #N$270F via #SKOOLKID$5C42(NEWPPC) (that line
. #HTML(<code>GO TO</code>s 15), then reclaims this stub with
. #SKOOLKID$19E5(RECLAIM-1) and falls into the interpreter. It never returns
. from #HTML(<code>USR</code>).
N $E933 Point #REGix at the machine stack and read the USR return word.
  $E933,$04 Clear #REGix.
  $E937,$02 Point #REGix at the machine stack.
  $E939,$03 Fetch the low byte of the USR return address into #REGa.
N $E93C Shuffle the USR return address and stash the reclaim start.
  $E93C,$01 Disable interrupts.
  $E93D,$04 Shift the high byte of the USR return address right.
  $E941,$02 Shift the low byte of the USR return address left.
  $E943,$03 Write the shuffled low byte back to the stack frame.
  $E946,$03 Mix in the high byte of the USR return address.
  $E949,$01 Stash the reclaim start address on the stack.
N $E94A Prepare flags and timing for the pilot-tone search.
  $E94A,$04 Set #REGix to #N($0001,$04,$04).
  $E94E,$01 Clear the carry flag.
  $E94F,$01 Set the carry flag.
  $E950,$01 Switch to the shadow flags.
  $E951,$02 Set the EAR/border state in #REGc to #N$22.
N $E953 Listen for six double edges that look like a pilot pulse.
@ $E953 label=Run_Bootstrap_Detect_Pilot
  $E953,$02 Set the pilot pair count in #REGe to #N$06.
N $E955 Timing loop body.
@ $E955 label=Run_Bootstrap_Detect_Pilot_Loop
  $E955,$02 Set the timing constant in #REGb to #N$9C.
  $E957,$03 Call #SKOOLKID$05E3(LD-EDGE-2).
  $E95A,$02 Jump back to #R$E953 if the carry flag is reset.
  $E95C,$05 Jump back to #R$E953 if #REGb is at least #N$C6.
  $E961,$01 Decrease the pilot pair count by one.
  $E962,$02 Jump to #R$E955 until the pilot pair count is zero.
  $E964,$01 Increase the pilot pair count by one.
N $E965 Prepare the data-block load into #R$5B01.
  $E965,$02 Set #REGa to #N$FF to indicate this is a data block, not a header.
  $E967,$01 Set the carry flag (load, do not verify).
  $E968,$01 Switch to the shadow flags.
  $E969,$03 Set the block length in #REGde to #N($0047,$04,$04) bytes.
  $E96C,$04 Point the load destination in #REGix at #R$5B01.
N $E970 Load the data block via #SKOOLKID$0556,$058F(LD-SYNC).
  $E970,$03 Call #SKOOLKID$0556,$058F(LD-SYNC).
N $E973 Apply the workspace patch and hand control back to BASIC.
@ $E973 label=Run_Bootstrap_Apply
  $E973,$01 Disable interrupts.
  $E974,$04 Fetch the reclaim end address into #REGde from #R$5B3F.
  $E978,$02 Jump to #R$E97A.
N $E97A Set NEWPPC from the loaded workspace.
@ $E97A label=Run_Bootstrap_Apply_Body
  $E97A,$03 Fetch #SKOOLKID$5C53(PROG) into #REGhl.
  $E97D,$01 Exchange #REGde and #REGhl.
  $E97E,$08 Write *#R$5B41 to *#SKOOLKID$5C42(NEWPPC).
  $E986,$04 Clear #SKOOLKID$5C44(NSPPC).
N $E98A Copy the workspace over #SKOOLKID$5C53(PROG).
  $E98A,$08 Copy #N$3E bytes from #R$5B01 over *#SKOOLKID$5C53(PROG).
N $E992 Seed #REGhl' and enable interrupts.
  $E992,$01 Switch to the shadow registers.
  $E993,$03 Set #REGhl' to #N$2758.
  $E996,$01 Switch back to the normal registers.
  $E997,$01 Enable interrupts.
N $E998 Reclaim this stub via #SKOOLKID$19E5(RECLAIM-1).
  $E998,$01 Restore the reclaim start address into #REGde from the stack.
  $E999,$03 Fetch #SKOOLKID$5C4B(VARS) into #REGhl (reclaim end).
  $E99C,$03 Jump to #SKOOLKID$19E5(RECLAIM-1).



u $E99F
  $E99F,$08

b $E9A7 BASIC Variables
@ $E9A7 label=BasicVariables
D $E9A7 Saved BASIC variables at load, from #SKOOLKID$5C4B(VARS) up to the
. #N$80 end marker. #HTML(<code>u</code> / <code>o</code> /
. <code>r</code> are the numeric constants #N$01 / #N$00 / #N$02;
. <code>hc</code> is the high score; <code>q$</code> is the high-score
. name.)
N $E9A7 Numeric variable u (#N$01).
  $E9A7,$06
N $E9AD Numeric variable o (#N$00).
  $E9AD,$06
N $E9B3 Numeric variable r (#N$02).
  $E9B3,$06
N $E9B9 Numeric variable hc (#N$00).
  $E9B9,$07
N $E9C0 String variable q$ ("NOBODY").
  $E9C0,$03 Name and length.
T $E9C3,$06 "NOBODY"
N $E9C9 End marker.
  $E9C9,$01

b $E9CA Edit Line
@ $E9CA label=EditLine
D $E9CA The current BASIC edit line, from #SKOOLKID$5C59(E_LINE) up to
. #SKOOLKID$5C61(WORKSP). Left over from #HTML(<code>LOAD ""</code>).
  $E9CA,$05

u $E9CF Unused
D $E9CF Free memory above #SKOOLKID$5C65(STKEND). #HTML(<code>WORKSP</code>,
. <code>STKBOT</code> and <code>STKEND</code> all point here in this
. snapshot, so the calculator stack is empty.) The non-zero bytes are
. leftover loader state, not program data; the ROM reuses this space for
. workspace and BASIC allocations as the game runs.
  $E9CF,$0951

b $F320 Plot Points
@ $F320 label=Plot_Points
D $F320 Twenty-eight coordinate pairs read by BASIC line 9870: LET X=62240
. then PLOT PEEK X,PEEK (X+1) for #N$1C steps.
  $F320,$38,$02

u $F358
  $F358,$02

