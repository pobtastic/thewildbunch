D $F35A Eight PLOT/DRAW segments (#N$04 bytes each: plot X, plot Y, draw
. X, draw Y) used by BASIC line 9800 via GO SUB 9900 with T=8.
  $F35A,$20,$04

u $F37A
  $F37A,$01

b $F37B Draw Segments
@ $F37B label=Draw_Segments_Ending
D $F37B Twenty-nine PLOT/DRAW segments (#N$04 bytes each) used by BASIC
. line 9870 via GO SUB 9900 with T=29.
  $F37B,$74,$04

u $F3EF
  $F3EF,$08

b $F3F7 Gunfight Character Set #N$01
@ $F3F7 label=Gunfight_Charset_1
D $F3F7 Ninety-six glyphs (codes #N$20-#N$7F) drawn by the street-fight
. sequence. BASIC line 5019 sets #SKOOLKID$5C36(CHARS) to #N$F2F7 so
. character code #N$20 reads from here.
  $F3F7,$08 #UDGTABLE(default,centre,centre)
. { #N($20+(#PC-$F3F7)/$08) | #UDG(#PC) } UDGTABLE#
L $F3F7,$08,$60

