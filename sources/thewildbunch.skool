; BASIC Terminator
;
; #HTML(#N$FFFF marker after the BASIC program, followed by two spare bytes
; before the <code>USR</code> target.)
@label=BASIC_Terminator
b$E92F DEFB $FF,$FF

; Unused
u$E931 DEFB $C4,$00

; Run Bootstrap
;
; One-shot startup trampoline. BASIC line 1 enters here via
; USR(VARS-#N$74). It is not game logic: it finishes the load, replaces the
; decoy line 1 at #SKOOLKID$5C53(PROG) with the real opening from #R$5B01,
; points BASIC at line #N$270F via #SKOOLKID$5C42(NEWPPC) (that line
; #HTML(<code>GO TO</code>s 15), then reclaims this stub with
; #SKOOLKID$19E5(RECLAIM-1) and falls into the interpreter. It never returns
; from #HTML(<code>USR</code>).
;
; .
;
; Point #REGix at the machine stack and read the USR return word.
@label=Run_Bootstrap
c$E933 LD IX,$0000     ; Clear #REGix.
 $E937 ADD IX,SP       ; Point #REGix at the machine stack.
 $E939 LD A,(IX+$14)   ; Fetch the low byte of the USR return address into
                       ; #REGa.
; Shuffle the USR return address and stash the reclaim start.
 $E93C DI              ; Disable interrupts.
 $E93D SLA (IX+$15)    ; Shift the high byte of the USR return address right.
 $E941 SLA A           ; Shift the low byte of the USR return address left.
 $E943 LD (IX+$14),A   ; Write the shuffled low byte back to the stack frame.
 $E946 XOR (IX+$15)    ; Mix in the high byte of the USR return address.
 $E949 PUSH BC         ; Stash the reclaim start address on the stack.
; Prepare flags and timing for the pilot-tone search.
 $E94A LD IX,$0001     ; Set #REGix to #N($0001,$04,$04).
 $E94E AND A           ; Clear the carry flag.
 $E94F SCF             ; Set the carry flag.
 $E950 EX AF,AF'       ; Switch to the shadow flags.
 $E951 LD C,$22        ; Set the EAR/border state in #REGc to #N$22.
; Listen for six double edges that look like a pilot pulse.
@label=Run_Bootstrap_Detect_Pilot
*$E953 LD E,$06        ; Set the pilot pair count in #REGe to #N$06.
; Timing loop body.
@label=Run_Bootstrap_Detect_Pilot_Loop
*$E955 LD B,$9C        ; Set the timing constant in #REGb to #N$9C.
 $E957 CALL $05E3      ; Call #SKOOLKID$05E3(LD-EDGE-2).
 $E95A JR NC,$E953     ; Jump back to #R$E953 if the carry flag is reset.
 $E95C LD A,$C6        ; {Jump back to #R$E953 if #REGb is at least #N$C6.
 $E95E CP B            ;
 $E95F JR NC,$E953     ; }
 $E961 DEC E           ; Decrease the pilot pair count by one.
 $E962 JR NZ,$E955     ; Jump to #R$E955 until the pilot pair count is zero.
 $E964 INC E           ; Increase the pilot pair count by one.
; Prepare the data-block load into #R$5B01.
 $E965 LD A,$FF        ; Set #REGa to #N$FF to indicate this is a data block,
                       ; not a header.
 $E967 SCF             ; Set the carry flag (load, do not verify).
 $E968 EX AF,AF'       ; Switch to the shadow flags.
 $E969 LD DE,$0047     ; Set the block length in #REGde to #N($0047,$04,$04)
                       ; bytes.
 $E96C LD IX,$5B01     ; Point the load destination in #REGix at #R$5B01.
; Load the data block via #SKOOLKID$0556,$058F(LD-SYNC).
 $E970 CALL $058F      ; Call #SKOOLKID$0556,$058F(LD-SYNC).
; Apply the workspace patch and hand control back to BASIC.
@label=Run_Bootstrap_Apply
 $E973 DI              ; Disable interrupts.
 $E974 LD DE,($5B3F)   ; Fetch the reclaim end address into #REGde from
                       ; #R$5B3F.
 $E978 JR $E97A        ; Jump to #R$E97A.
; Set NEWPPC from the loaded workspace.
@label=Run_Bootstrap_Apply_Body
*$E97A LD HL,($5C53)   ; Fetch #SKOOLKID$5C53(PROG) into #REGhl.
 $E97D EX DE,HL        ; Exchange #REGde and #REGhl.
 $E97E LD BC,($5B41)   ; {Write *#R$5B41 to *#SKOOLKID$5C42(NEWPPC).
 $E982 LD ($5C42),BC   ; }
 $E986 LD (IY+$0A),$00 ; Clear #SKOOLKID$5C44(NSPPC).
; Copy the workspace over #SKOOLKID$5C53(PROG).
 $E98A LD HL,$5B01     ; {Copy #N$3E bytes from #R$5B01 over
 $E98D LD BC,$003E     ; *#SKOOLKID$5C53(PROG).
 $E990 LDIR            ; }
; Seed #REGhl' and enable interrupts.
 $E992 EXX             ; Switch to the shadow registers.
 $E993 LD HL,$2758     ; Set #REGhl' to #N$2758.
 $E996 EXX             ; Switch back to the normal registers.
 $E997 EI              ; Enable interrupts.
; Reclaim this stub via #SKOOLKID$19E5(RECLAIM-1).
 $E998 POP DE          ; Restore the reclaim start address into #REGde from the
                       ; stack.
 $E999 LD HL,($5C4B)   ; Fetch #SKOOLKID$5C4B(VARS) into #REGhl (reclaim end).
 $E99C JP $19E5        ; Jump to #SKOOLKID$19E5(RECLAIM-1).

; Unused
u$E99F DEFB $00,$0D,$3E,$0E,$01,$64,$00,$0D

; BASIC Variables
;
; Saved BASIC variables at load, from #SKOOLKID$5C4B(VARS) up to the
; #N$80 end marker. #HTML(<code>u</code> / <code>o</code> /
; <code>r</code> are the numeric constants #N$01 / #N$00 / #N$02;
; <code>hc</code> is the high score; <code>q$</code> is the high-score
; name.)
;
; .
;
; Numeric variable u (#N$01).
@label=BasicVariables
b$E9A7 DEFB $75,$00,$00,$01,$00,$00
; Numeric variable o (#N$00).
 $E9AD DEFB $6F,$00,$00,$00,$00,$00
; Numeric variable r (#N$02).
 $E9B3 DEFB $72,$00,$00,$02,$00,$00
; Numeric variable hc (#N$00).
 $E9B9 DEFB $A8,$E3,$00,$00,$00,$00,$00
; String variable q$ ("NOBODY").
 $E9C0 DEFB $51,$06,$00                 ; Name and length.
 $E9C3 DEFM "NOBODY"                    ; "NOBODY"
; End marker.
 $E9C9 DEFB $80

; Edit Line
;
; The current BASIC edit line, from #SKOOLKID$5C59(E_LINE) up to
; #SKOOLKID$5C61(WORKSP). Left over from #HTML(<code>LOAD ""</code>).
@label=EditLine
b$E9CA DEFB $EF,$22,$22,$0D,$80

