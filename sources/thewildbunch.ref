;   tap2sna.py @thewildbunch.t2s
;   sna2skool.py -H --ini ListRefs=2 -c sources/thewildbunch.ctl TheWildBunch.z80 > sources/thewildbunch.skool
;   skool2html.py -H sources/thewildbunch.skool -T dark -T wide -toOa

